__pycache__/
*.pyc
.venv/
*.db
*.db-wal
*.db-shm
data/
*.egg-info/
dist/
build/
.DS_Store

# Benchmark working artifacts written at the repo root by benchmarks/run_trackb.sh
# (OUTPUT_DIR defaults to a repo-root-relative path; see benchmarks/README.md).
# Anchored to the root on purpose: curated result sets kept under
# benchmarks/measurements/ are tracked deliberately and must not be swept up here.
/trackb_results*/
/lmeb_results*/
/*.log

# Advisory mutation-diff lane scratch: the cosmic-ray session dir and
# the locally-written report. The session dir name avoids a *.sqlite suffix on
# purpose (the local db-guard hook flags those); CI uploads the report as an
# artifact rather than committing it.
/.mutation-diff/
/mutation-diff-report.json
site/

# The docs workflow installs mermaid + jsdom here with --no-save to parse the
# diagram sources (scripts/check-mermaid.mjs). Nothing is committed from it.
node_modules/
