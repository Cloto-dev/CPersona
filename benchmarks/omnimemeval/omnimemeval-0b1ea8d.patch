         client.add(speaker_a_messages, speaker_a_user_id,
                     session_key=session_key)
 
+    # ── CPersona: one store per conversation ─────────────────────────────
+    # The record id must be unique across conversations and versions: a store
+    # with an id already present is skipped as a duplicate.
+    elif frame in ("cpersona", "cpersona263"):
+        inject_time(speaker_a_messages, dt, frame)
+        client.add(speaker_a_messages, speaker_a_user_id,
+                   session_key=f"{speaker_a_user_id}:{session_key}")
+
     # ── Default: dual-speaker with inject_time ───────────────────────────
     else:
         inject_time(speaker_a_messages, dt, frame)
