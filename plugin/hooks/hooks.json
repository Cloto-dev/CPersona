{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" session-start || python \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" session-start",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" compact || python \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" compact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/scripts/cpersona_hooks.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
